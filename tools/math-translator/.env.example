# Copy this file to .env. The browser never receives these values.
LLM_PROVIDER=openai
OPENAI_TOKEN=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=90000
LLM_MAX_OUTPUT_TOKENS=60000

# Optional cloud-compatible proxy; do not point this at a local LLM.
# OPENAI_BASE_URL=https://api.openai.com/v1

# MiniMax OpenAI-compatible Chat Completions.
# Select MiniMax in the UI, or set LLM_PROVIDER=minimax as the default.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TOKEN=

# LocalAI OpenAI-compatible server. LocalAI usually exposes /v1 on port 8080.
# Select LocalAI in the UI, or set LLM_PROVIDER=localai as the default.
LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
LOCALAI_MODEL=
LOCALAI_API_KEY=local-ai
LOCALAI_API_STYLE=chat

# Local OpenAI-compatible server (Ollama, LM Studio, or vLLM).
# Select Local LLM in the UI, or set LLM_PROVIDER=local as the default.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TOKEN=local
# Use chat for broad compatibility; use responses when the local server supports /v1/responses.
LOCAL_LLM_API_STYLE=chat

HOST=127.0.0.1
PORT=8787
