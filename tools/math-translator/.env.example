# Copy this file to .env. The browser never receives these values.
LLM_PROVIDER=openai
OPENAI_TOKEN=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=90000
LLM_MAX_OUTPUT_TOKENS=60000

# Optional cloud-compatible proxy; do not point this at a local LLM.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local OpenAI-compatible server (Ollama, LM Studio, or vLLM).
# Select Local LLM in the UI, or set LLM_PROVIDER=local as the default.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TOKEN=local
# Use chat for broad compatibility; use responses when the local server supports /v1/responses.
LOCAL_LLM_API_STYLE=chat

HOST=127.0.0.1
PORT=8787
